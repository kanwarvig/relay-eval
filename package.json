{
  "name": "relay-eval",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "relay-eval": "./cli/relay-eval.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "publish:check": "node scripts/publish-check.mjs",
    "eval": "tsx cli/relay-eval.ts",
    "eval:gate": "tsx cli/relay-eval.ts gate --partition held_out --trials 5 --seed 1701",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run publish:check && npm run build"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
